# Copy to .env and fill in from your Supabase project settings.
# .env is gitignored — in production these come from Lovable Cloud / Cloudflare env bindings.
#
# VITE_-prefixed vars are inlined into the client bundle at build time (client.ts).
# The unprefixed duplicates are read via process.env during SSR (auth-middleware.ts).
# The publishable key is safe to expose — it ships in the client bundle by design.

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Not required by this app. The passcode hash is read only by SECURITY DEFINER
# functions, and user data is reached with the publishable key under RLS.
# If you ever need it, set it as a deploy-environment binding — never in .env.
# SUPABASE_SERVICE_ROLE_KEY=
